    VM --> VMC["mc_zcb<br/>exact OU transitions"]
  end
  ZY --> CAL

  subgraph hw["Hull-White (curve-fitted)"]
    DC --> FWD["fwd0: contractual FD<br/>h = 1e-5, central/one-sided"]
