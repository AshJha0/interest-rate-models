  subgraph curvebuild["Curve construction"]
    L[quotes loaders] --> INS["instruments<br/>Deposit / FRA / Swap / OISSwap<br/>(validated at construction)"]
    INS --> BS["bootstrap: per pillar<br/>solve residual(DF)=0<br/>Brent on [1e-10, 100]"]
