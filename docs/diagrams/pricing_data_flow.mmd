    AB --> OPT["zbc / zbp"]
    OPT --> CAPS["caplet / floorlet / cap"]
    AB --> JAM["jamshidian_swaption<br/>Brent for r*, expand bracket"]
    OPT --> JAM
    AB --> HMC["mc_caplet<br/>x + alpha(t), exact pathwise DF"]
  end

  VP --> TESTS["golden tests<br/>Python / C++ / Rust / Java"]
  CAPS --> TESTS
  JAM --> TESTS
  DC --> TESTS
